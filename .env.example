# Copy this file to .env and fill in ONE key (never commit .env).
# Priority if several are set: Gemini > Anthropic > OpenAI.

GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: override the default model (gemini-2.5-flash / claude-sonnet-5-5 / gpt-4o)
# PX_MODEL=gemini-2.5-pro
"@ | Set-Content .env.example -Encoding ascii